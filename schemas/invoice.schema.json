{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebouncer.dev/schemas/invoice.schema.json",
  "title": "eBouncer Invoice",
  "description": "按客户归因的费用账单（ebc bill --client X --format invoice 的输出契约）。v0.1=PDF/CSV/JSON；EU 格式（XRechnung/ZUGFeRD）为 v0.2 扩展位。金额一律保留来源口径注释，禁止数值补全。",
  "type": "object",
  "required": ["client", "period", "items", "total", "currency", "generated_at", "watermark"],
  "additionalProperties": false,
  "properties": {
    "client": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "type": "string", "format": "date-time" }, "to": { "type": "string", "format": "date-time" } }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "category", "qty", "unit_price_per_k_or_mtok", "amount"],
        "properties": {
          "tool": { "type": "string", "description": "claude-code | codex | dsh | ..." },
          "category": { "type": "string", "enum": ["token_input", "token_output", "cache_read", "cache_write", "search_request", "fetch_request"], "description": "cache_write 仅在费率表为该模型配置了 cache_write_per_mtok 时才有金额（Anthropic 语义）；DeepSeek 不单独收费，写缓存已含在缓存未命中的输入价里" },
          "qty": { "type": "number", "minimum": 0 },
          "unit_price_per_k_or_mtok": { "type": "number", "minimum": 0 },
          "amount": { "type": "number", "minimum": 0 },
          "price_source": { "type": "string", "description": "价格来源：费率表条目「厂商@生效版本」+ 价档（统一价/高峰价/空闲价×倍数），便于人工回查费率表；同一 tool×model 跨版本或跨价档时会拆成多行" },
          "note": { "type": ["string", "null"], "description": "口径注释：估算/账单实测/混合" }
        }
      }
    },
    "markup": { "type": "number", "minimum": 0, "default": 0, "description": "加成比例（服务报价用）" },
    "total": { "type": "number", "minimum": 0, "description": "含 markup 后的合计" },
    "currency": { "type": "string", "enum": ["CNY", "USD"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_basis": { "type": "string", "description": "ledger.jsonl 哈希——账单可对回原始账本（审计性）" },
    "rates_snapshot": {
      "type": "array",
      "description": "本单实际命中的费率条目原文（厂商/生效版本/单价/时段定义），按厂商+生效版本去重排序；费率表日后被改也能复盘这张单的价格依据",
      "items": { "type": "object" }
    },
    "rates_fingerprint": { "type": "string", "description": "费率快照的 sha256（64 位十六进制）——同一账本+同一费率表重开账单应得到同一值，用于复现性校验" },
    "watermark": { "type": "boolean", "description": "免费版强制 true：Generated by eBouncer + 官网链接" }
  }
}
